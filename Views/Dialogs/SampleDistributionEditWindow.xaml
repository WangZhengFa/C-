<Window x:Class="食品信息管理系统.Views.Dialogs.SampleDistributionEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="样品分发 编辑" Height="520" Width="760"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="6,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                <Button Content="新增" Height="26" Width="60" Margin="5,0" Background="#4CAF50" Foreground="White" BorderThickness="0" Click="NewButton_Click"/>
                <Button Content="保存" Height="26" Width="60" Margin="5,0" Background="#2196F3" Foreground="White" BorderThickness="0" Click="SaveButton_Click"/>
                <Button Content="重置" Height="26" Width="60" Margin="5,0" Background="#FF9800" Foreground="White" BorderThickness="0" Click="ResetButton_Click"/>
                <Button Content="关闭" Height="26" Width="60" Margin="5,0" Background="#757575" Foreground="White" BorderThickness="0" Click="CloseButton_Click"/>
            </StackPanel>
        </Border>

        <!-- 表单 -->
        <Grid Grid.Row="1" Margin="16,12,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="分发ID:" Foreground="#E53935" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="ReceiveSendIdText" VerticalContentAlignment="Center"/>

            <TextBlock Grid.Row="0" Grid.Column="2" Text="节点编号:" Foreground="#E53935" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
            <TextBox Grid.Row="0" Grid.Column="3" x:Name="NodeCodeText" VerticalContentAlignment="Center"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="取样日期:" Foreground="#E53935" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
            <DatePicker Grid.Row="1" Grid.Column="1" x:Name="ReceiveSendDatePicker" VerticalContentAlignment="Center" SelectedDateFormat="Short"/>

            <TextBlock Grid.Row="1" Grid.Column="2" Text="报告日期:" Foreground="#E53935" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
            <DatePicker Grid.Row="1" Grid.Column="3" x:Name="ReportDatePicker" VerticalContentAlignment="Center" SelectedDateFormat="Short"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="检验日期:" Foreground="#E53935" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
            <DatePicker Grid.Row="2" Grid.Column="1" x:Name="InspectionDatePicker" VerticalContentAlignment="Center" SelectedDateFormat="Short"/>

            <TextBlock Grid.Row="2" Grid.Column="2" Text="复检情况:" Foreground="#E53935" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
            <CheckBox Grid.Row="2" Grid.Column="3" x:Name="IsReinspectionCheck" Content="是" VerticalAlignment="Center"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="检品名称:" Foreground="#E53935" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
            <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" x:Name="SampleNameText" VerticalContentAlignment="Center"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="检品批号:" Foreground="#E53935" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
            <TextBox Grid.Row="4" Grid.Column="1" x:Name="SampleBatchText" VerticalContentAlignment="Center"/>

            <TextBlock Grid.Row="4" Grid.Column="2" Text="代表数量:" Foreground="#E53935" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
            <TextBox Grid.Row="4" Grid.Column="3" x:Name="RepresentativeQuantityText" VerticalContentAlignment="Center"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="取样数量:" Foreground="#E53935" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
            <TextBox Grid.Row="5" Grid.Column="1" x:Name="SampleQuantityText" VerticalContentAlignment="Center"/>

            <TextBlock Grid.Row="5" Grid.Column="2" Text="留样数量:" Foreground="#E53935" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
            <TextBox Grid.Row="5" Grid.Column="3" x:Name="RetentionQuantityText" VerticalContentAlignment="Center"/>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="检测来源:" Foreground="#E53935" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
            <ComboBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" x:Name="SampleSourceCombo" IsEditable="True" IsTextSearchEnabled="True" VerticalContentAlignment="Center"/>

            <TextBlock Grid.Row="7" Grid.Column="0" Text="备注说明:" Foreground="#E53935" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,6,8,0"/>
            <TextBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3" x:Name="RemarkText" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="4"/>
        </Grid>
    </Grid>
</Window>
