<Page x:Class="食品信息管理系统.Views.Pages.SampleDistributionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
      Title="样品分发">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                <Button Content="新增" Tag="add_btn" Height="26" Width="60" Margin="5,0" Background="#4CAF50" Foreground="White" BorderThickness="0" Click="AddButton_Click"/>
                <Button Content="编辑" Tag="edit_btn" Height="26" Width="60" Margin="5,0" Background="#2196F3" Foreground="White" BorderThickness="0" Click="EditButton_Click"/>
                <Button Content="删除" Tag="delete_btn" Height="26" Width="60" Margin="5,0" Background="#E53935" Foreground="White" BorderThickness="0" Click="DeleteButton_Click"/>
                <Button Content="刷新" Tag="refresh_btn" Height="26" Width="60" Margin="5,0" Background="#607D8B" Foreground="White" BorderThickness="0" Click="RefreshButton_Click"/>
                <Button Content="设置" Tag="settings_btn" Height="26" Width="60" Margin="5,0" Background="#607D8B" Foreground="White" BorderThickness="0" Click="SettingsButton_Click"/>
                <Button Content="关闭" Tag="close_btn" Height="26" Width="60" Margin="5,0" Background="#757575" Foreground="White" BorderThickness="0" Click="CloseButton_Click"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="8,6"
                MaxWidth="850" HorizontalAlignment="Left">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="关键字:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Grid.Column="1" x:Name="KeywordFilterText" MinWidth="80" VerticalContentAlignment="Center" Margin="0,0,12,0"
                         TextChanged="OnFilterChanged"/>

                <TextBlock Grid.Column="2" Text="检测来源:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Grid.Column="3" x:Name="SampleSourceFilterCombo" MinWidth="80" IsEditable="True" IsTextSearchEnabled="True" Margin="0,0,12,0"
                          SelectionChanged="OnFilterChanged" LostFocus="OnFilterChanged"/>

                <TextBlock Grid.Column="4" Text="取样日期:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <DatePicker Grid.Column="5" x:Name="DateFromPicker" SelectedDateFormat="Short" MinWidth="110" Margin="0,0,4,0"
                            SelectedDateChanged="OnFilterChanged" HorizontalAlignment="Stretch"/>
                <TextBlock Grid.Column="6" Text="~" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <DatePicker Grid.Column="7" x:Name="DateToPicker" SelectedDateFormat="Short" MinWidth="110" Margin="0,0,12,0"
                            SelectedDateChanged="OnFilterChanged" HorizontalAlignment="Stretch"/>

                <CheckBox Grid.Column="8" x:Name="OnlyReinspectionCheck" Content="仅复检" Margin="0,0,12,0" VerticalAlignment="Center"
                          Checked="OnFilterChanged" Unchecked="OnFilterChanged"/>

                <Button Grid.Column="9" Content="清空筛选" Width="86" Click="ClearFilters_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#DDDDDD" BorderThickness="0,0,1,0">
                <wfi:WindowsFormsHost x:Name="NodeTreeHost"/>
            </Border>

            <DataGrid Grid.Column="1" x:Name="RecordGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      GridLinesVisibility="Horizontal" BorderThickness="0" SelectionMode="Single" SelectionUnit="FullRow">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="分发ID" Binding="{Binding ReceiveSendId}" Width="120"/>
                    <DataGridTextColumn Header="节点编号" Binding="{Binding NodeCode}" Width="100"/>
                    <DataGridTextColumn Header="取样日期" Binding="{Binding ReceiveSendDate, StringFormat=yyyy-MM-dd}" Width="100"/>
                    <DataGridTextColumn Header="检验日期" Binding="{Binding InspectionDate, StringFormat=yyyy-MM-dd}" Width="100"/>
                    <DataGridTextColumn Header="报告日期" Binding="{Binding ReportDate, StringFormat=yyyy-MM-dd}" Width="100"/>
                    <DataGridTextColumn Header="检品名称" Binding="{Binding SampleName}" Width="160"/>
                    <DataGridTextColumn Header="检品批号" Binding="{Binding SampleBatch}" Width="120"/>
                    <DataGridTextColumn Header="取样数量" Binding="{Binding SampleQuantity}" Width="90"/>
                    <DataGridTextColumn Header="留样数量" Binding="{Binding RetentionQuantity}" Width="90"/>
                    <DataGridTextColumn Header="代表数量" Binding="{Binding RepresentativeQuantity}" Width="90"/>
                    <DataGridTextColumn Header="检测来源" Binding="{Binding SampleSource}" Width="110"/>
                    <DataGridCheckBoxColumn Header="复检" Binding="{Binding IsReinspection}" Width="70"/>
                    <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Page>
