<UserControl x:Class="食品信息管理系统.Views.Controls.DataGridSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:FoodEnterpriseIMS.Helpers"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Width="520" Height="460">
    <UserControl.Resources>
        <x:Array x:Key="WidthModes" Type="{x:Type sys:String}">
            <sys:String>自动</sys:String>
            <sys:String>拉伸</sys:String>
            <sys:String>固定</sys:String>
        </x:Array>
        <x:Array x:Key="SortOptions" Type="{x:Type sys:String}">
            <sys:String>自动</sys:String>
            <sys:String>升序</sys:String>
            <sys:String>降序</sys:String>
        </x:Array>
        <helpers:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Margin="0,0,0,8">
            <!-- 显示与排序 -->
            <TabItem Header="显示与排序">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ListBox x:Name="DisplayList" Grid.Column="0" ItemsSource="{Binding DisplayItems}" SelectionMode="Single">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type helpers:DisplayOrderItem}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Header, FallbackValue=(未命名)}" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="Black"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <Button Content="到顶" Width="70" Height="26" Margin="0,0,0,6" Click="TopButton_Click"/>
                        <Button Content="上移" Width="70" Height="26" Margin="0,0,0,6" Click="UpButton_Click"/>
                        <Button Content="下移" Width="70" Height="26" Margin="0,0,0,6" Click="DownButton_Click"/>
                        <Button Content="到底" Width="70" Height="26" Margin="0,0,0,6" Click="BottomButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- 字段详细设置 -->
            <TabItem Header="字段详细设置">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="FieldGrid" Grid.Row="0" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="False" IsReadOnly="False" SelectionMode="Single"
                              GridLinesVisibility="Horizontal" BorderThickness="1" ItemsSource="{Binding FieldRows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="字段" Binding="{Binding Header}" Width="Auto" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="列宽" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type helpers:ColumnSettingRow}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ComboBox Width="70" Height="22" Margin="4,0" VerticalContentAlignment="Center"
                                                      ItemsSource="{StaticResource WidthModes}"
                                                      SelectedItem="{Binding WidthMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBox Width="50" Height="22" Margin="4,0" VerticalContentAlignment="Center"
                                                     Text="{Binding FixedWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Visibility="{Binding IsFixedWidth, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <TextBlock Text="px" VerticalAlignment="Center" Margin="2,0,0,0"
                                                       Visibility="{Binding IsFixedWidth, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="左" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type helpers:ColumnSettingRow}">
                                        <CheckBox IsChecked="{Binding IsLeft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="中" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type helpers:ColumnSettingRow}">
                                        <CheckBox IsChecked="{Binding IsCenter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="右" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type helpers:ColumnSettingRow}">
                                        <CheckBox IsChecked="{Binding IsRight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="排序" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type helpers:ColumnSettingRow}">
                                        <ComboBox Width="78" Height="22" Margin="4,0" VerticalContentAlignment="Center"
                                                  ItemsSource="{StaticResource SortOptions}"
                                                  SelectedItem="{Binding Sort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="上移" Width="70" Height="26" Margin="0,0,8,0" Click="FieldUpButton_Click"/>
                        <Button Content="下移" Width="70" Height="26" Click="FieldDownButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- 行数表高 -->
            <TabItem Header="行数表高">
                <StackPanel Margin="12" VerticalAlignment="Top">
                    <GroupBox Header="行高设置" Padding="8" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="行高" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Width="70" Height="22" VerticalContentAlignment="Center"
                                     Text="{Binding RowHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="字体设置" Padding="8" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="字体大小" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Width="70" Height="22" VerticalContentAlignment="Center"
                                     Text="{Binding FontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="pt" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="行数表高" Padding="8" IsEnabled="{Binding AllowTableHeight}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="最大行数" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Width="70" Height="22" VerticalContentAlignment="Center"
                                         Text="{Binding MaxDisplayRows, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="（0 表示不限制）" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.7"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="表高开关" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <RadioButton Content="停用" IsChecked="{Binding TableHeightDisabled, Mode=TwoWay}" Margin="0,0,12,0" VerticalContentAlignment="Center"/>
                                <RadioButton Content="启用" IsChecked="{Binding TableHeightEnabled, Mode=TwoWay}" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="表高设置" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Width="90" Height="22" Margin="0,0,8,0"
                                          ItemsSource="{Binding TableHeightModes}" SelectedItem="{Binding TableHeightMode}"/>
                                <TextBox Width="80" Height="22" VerticalContentAlignment="Center"
                                         Text="{Binding TableHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="px" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </StackPanel>

                            <TextBlock Text="仅新增/编辑窗体可用，主窗体已禁用以防误操作。" Margin="0,8,0,0" Opacity="0.7"
                                       Visibility="{Binding AllowTableHeight, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="保存" Width="70" Height="26" Margin="0,0,8,0" Background="#4CAF50" Foreground="White" BorderThickness="0" Click="SaveButton_Click"/>
            <Button Content="关闭" Width="70" Height="26" Background="#757575" Foreground="White" BorderThickness="0" Click="CancelButton_Click"/>
        </StackPanel>

    </Grid>
</UserControl>
